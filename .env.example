# Full URL of Cup's v3 JSON endpoint.
CUP_API_URL=http://cup:8000/api/v3/json

# Go duration syntax, for example 30s, 5m, or 1h.
POLL_INTERVAL=5m
HTTP_TIMEOUT=15s

PUSHOVER_API_TOKEN=replace-with-your-application-token
PUSHOVER_USER_KEY=replace-with-your-user-or-group-key

# Optional E2EE key: exactly 64 hexadecimal characters (openssl rand -hex 32).
# Configure the same key in each receiving Pushover iOS/Android app.
# Leave empty to disable encryption.
PUSHOVER_ENCRYPTION_KEY=

# Optional endpoint used by the container's external connectivity check.
HEALTHCHECK_URL=https://api.pushover.net/1/

# debug, info, warn, or error
LOG_LEVEL=info
